# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for Google Maps JavaScript API.
# Restrict to HTTP referrers and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# ADMIN_PASSCODE: Optional server-side admin passcode for /admin dashboard access.
# If left empty, an inline first-run admin setup form allows claiming the initial admin account.
ADMIN_PASSCODE=

# Supabase Backend Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
